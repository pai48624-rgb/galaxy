---
// 메인 시안 a — 매거진형: 큰 기사 → 숫자 → [최신 글·소개·여행·분야 | 옆칸 순위·구독]. 블록은 전부 components/blocks, 데이터는 lib/data homeData().
import type { HomeData } from '~/lib/data';
import HeroMap from '~/components/blocks/HeroMap.astro';
import StatsRow from '~/components/blocks/StatsRow.astro';
import SectionNav from '~/components/blocks/SectionNav.astro';
import LatestTrend from '~/components/blocks/LatestTrend.astro';
import Intro from '~/components/blocks/Intro.astro';
import KoreaLatest from '~/components/blocks/KoreaLatest.astro';
import CategoryChips from '~/components/blocks/CategoryChips.astro';
import ToolList from '~/components/blocks/ToolList.astro';
import RankBox from '~/components/blocks/RankBox.astro';
import SubscribeBox from '~/components/blocks/SubscribeBox.astro';
export interface Props { d: HomeData }
const { d } = Astro.props;
---

<div id="top" class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-5 md:pt-7">
  <HeroMap d={d} />
  <StatsRow d={d} class="mt-3" />
</div>
<SectionNav items={[['#latest', '최신 글'], ['#rank', '순위'], ['#tools', '도구'], ['#korea', '여행'], ['#category', '분야']]} class="mt-5" />
<div class="max-w-[1320px] mx-auto px-4 sm:px-6 py-6 md:py-8 grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
  <div class="min-w-0">
    <LatestTrend d={d} limit={6} grid />
    <Intro d={d} class="mt-9" />
    <ToolList d={d} limit={10} rows class="mt-9" />
    <KoreaLatest d={d} limit={3} class="mt-9" />
    <CategoryChips d={d} show={12} class="mt-9" />
  </div>
  <aside class="space-y-5 min-w-0">
    <RankBox d={d} />
    <SubscribeBox />
  </aside>
</div>
