---
import { R } from '~/lib/routes';
// 메인 시안 c — 검색 중심 격자형: 가운데 큰 검색창 + 분야 탭 + 도구 카드 4열(첫 칸 2×2 = 3D 지도) + 오늘의 흐름(참고 m3_grid.html)
import { Icon } from 'astro-icon/components';
import type { HomeData } from '~/lib/data';
import SearchBox from '~/components/blocks/SearchBox.astro';
import SectionNav from '~/components/blocks/SectionNav.astro';
import RankBox from '~/components/blocks/RankBox.astro';
import LatestTrend from '~/components/blocks/LatestTrend.astro';
import KoreaLatest from '~/components/blocks/KoreaLatest.astro';
import CategoryChips from '~/components/blocks/CategoryChips.astro';
import Intro from '~/components/blocks/Intro.astro';
import SubscribeBox from '~/components/blocks/SubscribeBox.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
export interface Props { d: HomeData }
const { d } = Astro.props;
const tools = d.toolList.slice(0, 12);
const initials = (t: { name_en: string }) => t.name_en.replace(/[^A-Za-z0-9]/g, '').slice(0, 2) || 'AI';
const hue = (s: string) => { let h = 0; for (const ch of s) h = (h * 31 + ch.charCodeAt(0)) % 360; return h; };
---

<div id="top" class="max-w-[1320px] mx-auto px-4 sm:px-6 pt-8 md:pt-12 text-center">
  <h1 class="text-2xl md:text-4xl font-bold leading-tighter tracking-tighter font-heading text-heading text-balance">AI {d.nTools}개, 어느 별부터 볼까요</h1>
  <p class="mt-2 text-sm md:text-base text-muted"><b class="text-default">{d.nTools}개 AI · {d.cats.length}개 분야 · {d.nCombos}개 조합</b> — 매주 신호를 읽어 갱신합니다 ({d.today})</p>
  <SearchBox size="hero" placeholder="예: 클로드, 코딩 에이전트, 음성 합성" class="max-w-2xl mx-auto mt-5 text-left" />
  <div class="mt-3 flex flex-wrap justify-center gap-1.5 text-xs">
    <span class="text-muted py-1">인기</span>
    {d.cats.slice(0, 6).map((c) => <a href={R.category('ko', c.slug)} class="rounded-full border border-slate-700 px-2.5 py-1 hover:border-primary hover:text-link">{c.name}</a>)}
  </div>
</div>
<SectionNav items={[['#tools', '도구'], ['#rank', '순위'], ['#latest', '최신 글'], ['#korea', '여행'], ['#category', '분야']]} class="mt-6" />
<div class="max-w-[1320px] mx-auto px-4 sm:px-6 py-6 md:py-8">
  <section id="tools" class="scroll-mt-28">
    <SectionHead title="AI 도구" href={R.ai()} more={`${d.nTools}개 모두`} />
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <a href={R.map()} class="group sm:col-span-2 sm:row-span-2 relative overflow-hidden rounded-md border border-primary/50 bg-black min-h-56">
        <img src="/img/map_preview.jpg" alt="AI 성단 지도 3D 화면" width="1600" height="900" class="absolute inset-0 w-full h-full object-cover object-left-top opacity-80 group-hover:opacity-100 transition" fetchpriority="high" />
        <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-page via-page/80 to-transparent">
          <b class="flex items-center gap-1 text-base md:text-lg text-heading"><Icon name="tabler:sparkles" class="w-4 h-4 text-link" />3D 성단 지도 — 별 {d.nTools}개를 우주에서 보기</b>
          <span class="btn-primary mt-2 text-sm py-1.5 px-4 inline-flex">지도 열기<Icon name="tabler:arrow-right" class="w-4 h-4 ml-1 -mr-1" /></span>
        </div>
      </a>
      {tools.map(({ t, href }) => (
        <a href={href} class="block rounded-md border border-slate-700 bg-slate-900/40 p-3.5 hover:border-primary/70 transition">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 shrink-0 rounded-md grid place-items-center text-xs font-bold text-white" style={`background:hsl(${hue(t.slug)} 45% 38%)`} aria-hidden="true">{initials(t)}</span>
            <div class="min-w-0"><b class="block text-sm text-heading truncate">{t.name}</b><small class="text-xs text-muted">{t.category}</small></div>
          </div>
          <p class="text-xs text-muted mt-2.5 line-clamp-2">{t.desc_ko}</p>
          <div class="mt-2.5 flex items-center justify-between text-[11px]"><span class="text-muted truncate">{t.subcategory || t.category_en}</span><span class="rounded-full border border-slate-700 px-2 py-0.5 text-muted">{t.pricing}</span></div>
        </a>
      ))}
    </div>
  </section>
  <RankBox d={d} row class="mt-8" />
  <LatestTrend d={d} limit={4} grid class="mt-8" />
  <div class="grid grid-cols-[minmax(0,1fr)] gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] mt-8">
    <KoreaLatest d={d} limit={4} cols={4} class="lg:col-span-2" />
  </div>
  <CategoryChips d={d} show={12} class="mt-8" />
  <Intro d={d} class="mt-8" />
  <SubscribeBox banner class="mt-8" />
</div>
