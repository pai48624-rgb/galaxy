---
// astrowind Breadcrumbs.astro — permalinks 의존만 config로 바꿈
import { Icon } from 'astro-icon/components';
import { SITE } from '~/config';

export interface Props {
  items: Array<{ text: string; href?: string; icon?: string }>;
  bar?: boolean;
  hideCurrent?: boolean;
  class?: string;
}

const { items, bar = false, hideCurrent = false, class: className = '' } = Astro.props;

// 구조화 데이터(2026-10-16 서치콘솔 "'item' 입력란 누락(itemListElement)"): 중간 칸에 링크 없는 항목(예: AI 상세의 세부 분야)이
// 'item' 없이 들어가 오류 → 주소 있는 칸만 넣고, 마지막(현재 페이지)은 이 페이지 주소를 넣는다. 화면 표시는 그대로.
const pageUrl = new URL(Astro.url.pathname, SITE.site).href;
const schemaItems = items
  .map(({ text, href }, index) => ({ name: text, url: href ? new URL(href, SITE.site).href : index === items.length - 1 ? pageUrl : '' }))
  .filter((x) => x.url && x.name);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: schemaItems.map((x, index) => ({ '@type': 'ListItem', position: index + 1, name: x.name, item: x.url })),
};
---

<nav
  aria-label="Breadcrumb"
  class:list={[
    'text-sm text-muted',
    bar ? 'max-w-[1320px] mx-auto w-full px-3 lg:px-6 pt-4 [&>ol]:ml-2 rtl:[&>ol]:ml-0 rtl:[&>ol]:mr-2' : '',
    className,
  ]}
>
  <ol class="flex flex-wrap items-center gap-1 list-none">
    {
      items.map(({ text, href, icon }, index) => (
        <li class="flex min-w-0 items-center gap-1">
          {index > 0 && !(hideCurrent && index === items.length - 1) && (
            <Icon name="tabler:chevron-right" class="h-3.5 w-3.5 shrink-0 opacity-60 rtl:rotate-180" />
          )}
          {href && index < items.length - 1 ? (
            <a href={href} class="inline-flex items-center hover:text-link hover:underline" aria-label={icon ? text : undefined}>
              {icon ? <Icon name={icon} class="h-4 w-4" /> : text}
            </a>
          ) : (
            <span aria-current="page" class:list={hideCurrent ? 'sr-only' : 'text-default'}>
              {text}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
