---
// AI 트렌드 목록 — 번갈아 배치(2026-10-14 사용자 시안: 번호+제목+요약+날짜·분류 / 사진 카드, 줄마다 좌우 바뀜).
// 껍데기만 시안을 따르고 색·글꼴은 사이트 토큰. 사진 = 글 본문 첫 그림, 없으면 대표 태그를 넣은 사이트 색 상자.
// 빌드 때 정적으로 그리고, 한국어판은 열릴 때 /api/trend/latest 로 새 글을 같은 모양으로 다시 그림(조회수는 세지 않으므로 표시 안 함).
import { R } from '~/lib/routes';
import { TREND_API } from '~/config';
import { fmtDate } from '~/utils/utils';
import type { TrendPost } from '~/lib/data';
import { tx, trendEn } from '~/i18n/tr';
import { ui } from '~/i18n/ui';
export interface Props { posts: TrendPost[]; lang?: 'ko' | 'en' }
const { posts, lang = 'ko' } = Astro.props;
const empty = ui(lang).home.noPosts;
const badge = ui(lang).trend.koreanBadge;
const tagOf = (p: TrendPost) => (lang === 'en' ? p.tags.find((t) => /^[A-Za-z]/.test(t)) : p.tags[0]) || '';
// 글자 카드 위 작은 분류(그림 속 '# AI 도구별 리뷰' 자리): 'AI 도구 리뷰' 태그가 있으면 그것, 없으면 대표 태그
const kickerOf = (p: TrendPost) => (lang === 'en' ? p.tags.find((t) => /^[ -~]+$/.test(t)) : p.tags.find((t) => t === 'AI 도구 리뷰') || tagOf(p)) || 'AI';
---

<trend-zigzag data-api={lang === 'en' ? '' : TREND_API} data-lang={lang}>
  <ol class="list-none p-0 m-0 tz-list" data-list>
    {posts.length ? posts.map((p, i) => {
      const href = R.trendPost(p.id, lang);
      const title = (lang === 'en' && trendEn(p.id)?.title) || tx(p.title, lang);
      const tag = tagOf(p);
      return (
        <li class:list={['tz-row', i % 2 ? 'tz-flip' : '']}>
          <a href={href} class="tz-text group" hreflang={lang === 'en' && !trendEn(p.id) ? 'ko' : undefined}>
            <div class="flex gap-3 items-start">
              <span class="tz-num">{i + 1}</span>
              <b class="tz-title group-hover:text-link">{title}</b>
            </div>
            <p class="tz-sum">{tx(p.summary, lang)}</p>
            <div class="tz-meta">
              <span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/></svg>{fmtDate(p.created_at, lang)}</span>
              {tag && <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2"/></svg>{tag}</span>}
              {badge && !trendEn(p.id) && <span class="tz-badge">{badge}</span>}
            </div>
          </a>
          <a href={href} class="tz-pic" tabindex="-1" aria-hidden="true">
            {p.thumb
              ? <Fragment set:html={p.thumb} />
              : p.img
              ? <span class="tz-ph tz-band"><small># {kickerOf(p)}</small><b>{title}</b><em></em><i>&lt;/&gt;</i></span>
              : <span class="tz-ph"><i>✦</i><b>{tag || 'AI'}</b></span>}
          </a>
        </li>
      );
    }) : <li class="py-4 text-muted">{empty}</li>}
  </ol>
</trend-zigzag>

<style is:global>
  .tz-row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.25rem; align-items: center; padding: 1.75rem 0; border-bottom: 1px solid rgb(30 41 59); }
  .tz-row:last-child { border-bottom: 0; }
  @media (min-width: 768px) {
    .tz-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2.5rem; }
    .tz-row.tz-flip .tz-text { order: 2; }
  }
  .tz-text { display: block; min-width: 0; }
  .tz-num { font-family: Georgia, 'Times New Roman', serif; font-size: 2.6rem; line-height: .9; font-weight: 700; color: var(--aw-color-primary); opacity: .85; flex: none; }
  .tz-title { display: block; font-size: 1.3rem; line-height: 1.45; font-weight: 700; color: var(--aw-color-text-heading); word-break: keep-all; }
  .tz-sum { word-break: keep-all; margin-top: .85rem; color: var(--aw-color-text-muted); line-height: 1.75; }
  .tz-meta { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: .4rem 1rem; font-size: .8rem; color: var(--aw-color-text-muted); }
  .tz-meta > span { display: inline-flex; align-items: center; gap: .35rem; }
  .tz-meta svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tz-badge { border: 1px solid rgb(71 85 105); border-radius: 999px; padding: 0 .5rem; font-size: 11px; }
  .tz-pic { display: block; min-width: 0; border: 1px solid rgb(51 65 85); border-radius: 1rem; padding: .5rem; background: rgb(15 23 42 / .4); transition: border-color .15s; }
  .tz-pic:hover { border-color: rgb(var(--aw-color-primary-rgb, 124 108 240) / .7); }
  .tz-ph { display: block; width: 100%; aspect-ratio: 16 / 10; border-radius: .75rem; }
  /* 사진 칸 배경 = 밤하늘(별 + 성운, CSS만 — 외부 그림 없음). 글 첫 그림(글자 띠)은 띠 배경이 남아 쓰지 않고, 같은 배치를 글자로 이 위에 바로 그림(10/14 사용자 "별 배경만") */
  .tz-ph {
    background:
      radial-gradient(1px 1px at 12% 18%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 27% 72%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 41% 33%, #e0e7ff 50%, transparent 51%), radial-gradient(1px 1px at 58% 84%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 69% 14%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 83% 61%, #c7d2fe 50%, transparent 51%),
      radial-gradient(2px 2px at 91% 27%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 6% 88%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 35% 9%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 77% 92%, #e0e7ff 50%, transparent 51%),
      radial-gradient(1px 1px at 50% 55%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 18% 45%, #c7d2fe 50%, transparent 51%),
      radial-gradient(1px 1px at 95% 75%, #fff 50%, transparent 51%),
      radial-gradient(ellipse 60% 45% at 78% 22%, rgb(124 108 240 / .38), transparent 70%),
      radial-gradient(ellipse 55% 40% at 18% 82%, rgb(56 189 248 / .22), transparent 70%),
      radial-gradient(ellipse 40% 30% at 45% 50%, rgb(236 72 153 / .10), transparent 70%),
      linear-gradient(180deg, #050816 0%, #0a0f2c 55%, #060818 100%);
  }
  .tz-ph { display: grid; place-items: center; align-content: center; gap: .4rem; color: var(--aw-color-text-heading); text-align: center; padding: 1rem; }
  .tz-ph i { font-style: normal; font-size: 1.6rem; color: var(--aw-color-primary); }
  .tz-ph b { font-size: 1.35rem; font-weight: 700; word-break: keep-all; }
  .tz-band { position: relative; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; text-align: left; gap: .55rem; padding: 1.5rem 4.5rem 1.5rem 1.75rem; }
  .tz-band small { font-size: .72rem; font-weight: 700; letter-spacing: .04em; color: rgb(125 211 252); }
  .tz-band b { font-size: 1.2rem; line-height: 1.45; color: #fff; text-shadow: 0 1px 12px rgb(5 8 22 / .9); }
  .tz-band em { display: block; width: 2.4rem; height: 3px; border-radius: 2px; background: linear-gradient(90deg, rgb(56 189 248), rgb(124 108 240)); }
  .tz-band i { position: absolute; right: 1.5rem; top: 50%; transform: translateY(-50%); font-size: 1.5rem; font-weight: 700; color: rgb(139 124 246); }
  /* 글 그림 썸네일(2026-10-21): 궤도 등 글의 첫 그림 / 숫자 카드 3개 — 워커 trendThumb */
  .tz-fig { display: grid; place-items: center; padding: .5rem; }
  .tz-fig svg { width: 100%; height: 100%; max-height: 100%; }
  .tz-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; padding: 1rem; align-content: center; }
  .tz-tiles > span { display: grid; gap: .3rem; padding: .8rem .6rem; border: 1px solid rgb(51 65 85 / .8); border-radius: .75rem; background: rgb(10 15 44 / .72); text-align: left; }
  .tz-tiles b { font-size: 1.45rem; line-height: 1.1; color: #f5b83d; word-break: keep-all; }
  .tz-tiles small { font-size: .78rem; line-height: 1.35; color: rgb(203 213 225); word-break: keep-all; }
  @media (max-width: 480px) { .tz-band { padding: 1rem 3.5rem 1rem 1.25rem; } .tz-band b { font-size: 1.05rem; } .tz-band i { right: 1rem; font-size: 1.25rem; } }
</style>

<script>
  class TrendZigzag extends HTMLElement {
    async connectedCallback() {
      const api = this.dataset.api, list = this.querySelector('[data-list]') as HTMLElement | null;
      if (!api || !list) return;
      try {
        const r = await fetch(api, { cache: 'default' });
        if (!r.ok) return;
        const posts = ((await r.json()).posts || []) as any[];
        if (!posts.length) return;
        const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
        const fmt = (iso: string) => { const d = new Date(new Date(iso).getTime() + 9 * 3600e3); return `${d.getUTCFullYear()}년 ${d.getUTCMonth() + 1}월 ${d.getUTCDate()}일`; };
        // 아이콘·모양은 빌드 때 그린 첫 줄에서 그대로 복사(모양 한 곳)
        const cal = list.querySelector('.tz-meta span svg')?.outerHTML || '';
        const fold = list.querySelectorAll('.tz-meta span svg')[1]?.outerHTML || '';
        list.innerHTML = posts.map((p, i) => {
          const href = `/trend/${p.id}`, tag = (p.tags || [])[0] || '';
          const kicker = (p.tags || []).find((t: string) => t === 'AI 도구 리뷰') || tag || 'AI';
          const img = p.thumb ? p.thumb : p.img ? `<span class="tz-ph tz-band"><small># ${esc(kicker)}</small><b>${esc(p.title)}</b><em></em><i>&lt;/&gt;</i></span>` : `<span class="tz-ph"><i>✦</i><b>${esc(tag || 'AI')}</b></span>`;
          return `<li class="tz-row${i % 2 ? ' tz-flip' : ''}"><a href="${href}" class="tz-text group"><div class="flex gap-3 items-start"><span class="tz-num">${i + 1}</span><b class="tz-title group-hover:text-link">${esc(p.title)}</b></div><p class="tz-sum">${esc(p.summary)}</p><div class="tz-meta"><span>${cal}${fmt(p.created_at)}</span>${tag ? `<span>${fold}${esc(tag)}</span>` : ''}</div></a><a href="${href}" class="tz-pic" tabindex="-1" aria-hidden="true">${img}</a></li>`;
        }).join('');
      } catch (e) { /* 실패하면 빌드 때 목록 그대로 */ }
    }
  }
  if (!customElements.get('trend-zigzag')) customElements.define('trend-zigzag', TrendZigzag);
</script>
