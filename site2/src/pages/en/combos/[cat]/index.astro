// 영어판 — 한국어 화면(combos/[cat]/index.astro)을 lang="en" 으로 그대로 씀(문구: src/i18n/ui.ts, 데이터 번역: src/i18n/cache)
import Page from '../../../combos/[cat]/index.astro';
import { comboCategories } from '~/lib/data2';
export async function getStaticPaths() {
  return comboCategories().map((c) => ({ params: { cat: c.slug }, props: { c } }));
}
---

<Page c={Astro.props.c} lang="en" />
