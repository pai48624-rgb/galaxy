---
// 요금 묶음 페이지(/pricing/<묶음>/ 6쪽 + /pricing/free/ 무료로 시작하는 AI): 분야별로 나눠 도구 행 나열. 묶음 기준 한 줄 + 확인일 표기.
// 영어판 /en/pricing/<묶음>/ 는 이 파일을 lang="en" 으로
import PageLayout from '~/layouts/PageLayout.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import SectionHead from '~/components/ui/SectionHead.astro';
import ToolRow from '~/components/blocks2/ToolRow.astro';
import SourceNote from '~/components/blocks2/SourceNote.astro';
import { pricingGroups, freeStartGroup, dataDate, type PricingGroupView } from '~/lib/data2';
import { catSlug } from '~/lib/data';
import { clip } from '~/utils/utils';
import { ui } from '~/i18n/ui';
import { lp, type Lang } from '~/i18n/tr';

export async function getStaticPaths() {
  return [freeStartGroup(), ...pricingGroups()].map((g) => ({ params: { group: g.slug }, props: { g } }));
}
const { g, lang = 'ko' } = Astro.props as { g: PricingGroupView; lang?: Lang };
const T = ui(lang);
const U = T.pricing;
const isFree = g.slug === 'free';
const gv = (x: { slug: string; name: string; rule: string }) => (lang === 'en' ? (x.slug === 'free' ? U.free : U.groups[x.slug]) || x : x);
const others = pricingGroups().filter((x) => x.slug !== g.slug);
const catEn = new Map(g.rows.map((r) => [r.t.category, r.t.category_en || r.t.category]));
const cName = (n: string) => (lang === 'en' ? catEn.get(n) || n : n);
// 분야별 구역(도구 많은 순) — 구역 id 는 분야 영문 슬러그
const sections = g.cats.map((c) => ({ ...c, id: catSlug(g.rows.find((r) => r.t.category === c.name)!.t.category_en || c.name) || c.name, rows: g.rows.filter((r) => r.t.category === c.name) }));
const name = gv(g).name, rule = gv(g).rule;
const title = isFree ? U.gTitleFree(g.n) : U.gTitle(name, g.n);
const description = clip(U.gDesc(name, g.n, g.cats.slice(0, 4).map((c) => `${cName(c.name)} ${T.common.count(c.n)}`).join(', '), rule), 155);
import { R } from '~/lib/routes';
---

<PageLayout metadata={{ title, description, canonical: R.pricing(lang, g.slug), lang }}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-7 md:py-9">
    <Breadcrumbs items={[{ text: T.common.aiList, href: R.ai(lang) }, { text: T.common.pricing, href: R.pricing(lang) }, { text: name }]} class="mb-3" />
    <h1 class="text-2xl md:text-3xl font-bold leading-tighter tracking-tighter font-heading text-heading">{U.gH1(name, g.n)}</h1>
    <p class="mt-2 text-base text-muted text-pretty"><span class="text-default/80">{U.rule}</span> — {rule}{U.ruleTail(dataDate())}</p>
    <p class="mt-2 text-sm text-muted">{U.gMeta(g.cats.length, g.nPage)}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {sections.map((s) => <a href={`#${s.id}`} class="rounded-full border border-slate-700 px-3 py-1 text-xs hover:border-primary hover:text-link transition">{cName(s.name)} <span class="text-muted">{s.n}</span></a>)}
    </div>

    {sections.map((s) => {
      const ch = g.rows.find((r) => r.t.category === s.name)?.catHref;
      return (
        <section id={s.id}>
          <SectionHead title={U.secN(cName(s.name), s.n)} href={ch ? lp(ch, lang) : undefined} more={ch ? T.common.fieldAll : undefined} />
          <ul class="divide-y divide-slate-800">
            {s.rows.map((r) => <ToolRow r={r} lang={lang} />)}
          </ul>
        </section>
      );
    })}

    <SectionHead title={U.others} href={R.pricing(lang)} more={T.common.seeAllMore} />
    <div class="flex flex-wrap gap-2">
      {!isFree && <a href={R.pricing(lang, 'free')} class="rounded-full border border-primary/60 px-3.5 py-1.5 text-sm hover:border-primary hover:text-link transition">{lang === 'en' ? U.free.name : freeStartGroup().name} <span class="text-muted">{freeStartGroup().n}</span></a>}
      {others.map((x) => <a href={R.pricing(lang, x.slug)} class="rounded-full border border-slate-700 px-3.5 py-1.5 text-sm hover:border-primary hover:text-link transition">{gv(x).name} <span class="text-muted">{x.n}</span></a>)}
    </div>
    <SourceNote lang={lang} source={U.gSource} note={U.note} />
  </div>
</PageLayout>
