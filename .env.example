# cp .env.example .env  후 값 채우기 — .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 포함)

# ── 부트스트랩(스키마+데이터 적재)용 ── npm run bootstrap 이 사용하는 값 ──
# Supabase Dashboard ▸ 프로젝트 ▸ [Connect] ▸ "Session pooler" 의 URI 를 그대로 붙여넣기.
# 형식: postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── (구) import-data.mjs 용 — bootstrap 을 쓰면 불필요 ──
# Supabase Dashboard ▸ Project Settings ▸ API
SUPABASE_URL=https://urflispegkzouclljxzg.supabase.co
# service_role (secret) 키 — RLS 우회. 임포트 스크립트 + 네이버 로그인(dist/_worker.js)에서 사용,
# 브라우저에 절대 노출하지 말 것. 로컬 테스트는 이 .env로 충분하지만, 실제 배포(npm run deploy)에는
# Cloudflare Pages 대시보드 ▸ 프로젝트(ai-galaxy) ▸ Settings ▸ Environment variables 에
# 아래 3개를 "Secret"으로 별도 등록해야 함(.env는 배포에 올라가지 않음).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── 네이버 로그인(dist/_worker.js §NAVER) 용 — 네이버 개발자센터(developers.naver.com)에서 발급 ──
# 애플리케이션 등록 시 Callback URL: https://aigalaxy-map.com/api/auth/naver/callback
# (로컬 테스트 시엔 http://127.0.0.1:8788/api/auth/naver/callback 도 추가 등록 필요)
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
