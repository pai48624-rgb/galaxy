# cp .env.example .env  후 값 채우기 — .env 는 절대 커밋하지 마세요 (.gitignore 에 이미 포함)

# ── 부트스트랩(스키마+데이터 적재)용 ── npm run bootstrap 이 사용하는 값 ──
# Supabase Dashboard ▸ 프로젝트 ▸ [Connect] ▸ "Session pooler" 의 URI 를 그대로 붙여넣기.
# 형식: postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── (구) import-data.mjs 용 — bootstrap 을 쓰면 불필요 ──
# Supabase Dashboard ▸ Project Settings ▸ API
SUPABASE_URL=https://urflispegkzouclljxzg.supabase.co
# service_role (secret) 키 — RLS 우회. 임포트 스크립트에서만 사용, 브라우저에 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
